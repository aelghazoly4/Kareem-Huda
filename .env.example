# حطهم في Vercel ← Project ← Settings ← Environment Variables

# رابط MongoDB (ينفع نفس الكلاستر بتاع ميثاق — الردود بتتحفظ في قاعدة لوحدها)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# اختياري: اسم القاعدة (الافتراضي kareem_huda_wedding)
MONGODB_DB=kareem_huda_wedding

# كلمة سر صفحة الردود — أي كلام طويل عشوائي، وبتبعته للعروسين في اللينك
RESPONSES_KEY=
